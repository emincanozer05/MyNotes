# Supabase project credentials — https://supabase.com/dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Feynman modu ve metin seçimi "Açıkla" özelliği için gerekecek:
# ANTHROPIC_API_KEY=sk-ant-...

# "Açıkla" (seçili metin açıklaması) için Google Gemini. Anahtar tanımlıysa
# Gemini kullanılır, yoksa ANTHROPIC_API_KEY'e düşer.
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.5-flash
# EXPLAIN_PROVIDER=gemini   # gemini | anthropic (zorla)

# Tek kullanıcılı otomatik giriş: site açıldığında bu hesapla otomatik oturum açılır.
# Supabase'de (Authentication → Users) önce bu hesabı oluşturun. NEXT_PUBLIC_ ile
# BAŞLAMAMALIDIR; yalnızca sunucuda okunur.
OWNER_EMAIL=you@example.com
OWNER_PASSWORD=your-password
