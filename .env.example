# Supabase project credentials — https://supabase.com/dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Aşama 5 (Feynman modu) için gerekecek:
# ANTHROPIC_API_KEY=sk-ant-...

# Tek kullanıcılı otomatik giriş: site açıldığında bu hesapla otomatik oturum açılır.
# Supabase'de (Authentication → Users) önce bu hesabı oluşturun. NEXT_PUBLIC_ ile
# BAŞLAMAMALIDIR; yalnızca sunucuda okunur.
OWNER_EMAIL=you@example.com
OWNER_PASSWORD=your-password
