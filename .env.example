# Supabase project credentials — https://supabase.com/dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Aşama 5 (Feynman modu) için gerekecek:
# ANTHROPIC_API_KEY=sk-ant-...

# Şifre sıfırlama e-postalarındaki bağlantının işaret edeceği alan adı.
